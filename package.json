{
  "name": "sciplotflow",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gifs": "node scripts/gifs/record.ts",
    "dev:lan": "vite --mode lan --host --port 5181 --strictPort",
    "build": "tsc -b && vite build && node scripts/api.ts dist",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "node scripts/check.ts",
    "validation": "node scripts/check.ts --validation",
    "test-images": "node scripts/make-test-images.ts",
    "check:ui": "rolldown scripts/check-ui.tsx --format esm --platform node --no-code-splitting --log-level silent -o node_modules/.tmp/check-ui.mjs && node node_modules/.tmp/check-ui.mjs",
    "bench": "rolldown scripts/bench.ts --format esm --platform node -o node_modules/.tmp/bench.mjs && node node_modules/.tmp/bench.mjs",
    "licenses": "node scripts/licenses.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@mathjax/mathjax-fira-font": "^4.1.3",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/mathjax-stix2-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@xyflow/react": "^12.11.6",
    "fflate": "^0.8.2",
    "lucide-react": "^1.59.0",
    "paper": "^0.12.18",
    "paperjs-offset": "^2.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "utif2": "^4.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
